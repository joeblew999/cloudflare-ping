{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["void/env", "node"],
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true
  },
  "include": ["src", "pages", "routes", "middleware", "crons", "queues", "db", "cli", "*.ts"],
  "exclude": ["cli/dist"]
}
